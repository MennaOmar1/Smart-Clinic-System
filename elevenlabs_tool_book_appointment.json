{
  "type": "webhook",
  "name": "Book_Appointment",
  "description": "Book a confirmed appointment with a specific doctor. Must ONLY be called AFTER Check_Availability confirms the slot is free AND the user gives explicit confirmation. Creates the appointment in the clinic database.",
  "disable_interruptions": true,
  "force_pre_tool_speech": "auto",
  "assignments": [
    {
      "source": "response",
      "dynamic_variable": "booking_success",
      "value_path": "booking_success"
    },
    {
      "source": "response",
      "dynamic_variable": "booking_confirmation",
      "value_path": "booking_confirmation"
    },
    {
      "source": "response",
      "dynamic_variable": "appointment_id",
      "value_path": "appointment_id"
    }
  ],
  "tool_call_sound": null,
  "tool_call_sound_behavior": "auto",
  "execution_mode": "immediate",
  "api_schema": {
    "url": "https://smart-clinic-system-production.up.railway.app/elevenlabs/book",
    "method": "POST",
    "path_params_schema": [],
    "query_params_schema": [],
    "request_body_schema": {
      "id": "body",
      "type": "object",
      "description": "Complete appointment booking data",
      "properties": [
        {
          "id": "doctor_id",
          "type": "number",
          "value_type": "llm_prompt",
          "description": "The numeric doctor ID (e.g. 1, 2, 3). Must match the ID obtained from List_Doctors.",
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null,
          "is_system_provided": false,
          "required": true
        },
        {
          "id": "patient_name",
          "type": "string",
          "value_type": "llm_prompt",
          "description": "Patient's full name (minimum 2 characters)",
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null,
          "is_system_provided": false,
          "required": true
        },
        {
          "id": "patient_phone",
          "type": "string",
          "value_type": "llm_prompt",
          "description": "Patient's phone number with country code (minimum 6 digits, e.g. +201012345678)",
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null,
          "is_system_provided": false,
          "required": true
        },
        {
          "id": "time",
          "type": "string",
          "value_type": "llm_prompt",
          "description": "Appointment date and time in ISO 8601 format (e.g. 2026-05-12T10:00:00). Must be a future weekday between 08:00-17:00 Africa/Cairo. Minutes must be :00 or :30.",
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null,
          "is_system_provided": false,
          "required": true
        },
        {
          "id": "reason",
          "type": "string",
          "value_type": "llm_prompt",
          "description": "Reason for visit or primary symptoms described by the patient",
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null,
          "is_system_provided": false,
          "required": false
        },
        {
          "id": "patient_email",
          "type": "string",
          "value_type": "llm_prompt",
          "description": "Patient's email address for appointment confirmation (optional)",
          "dynamic_variable": "",
          "constant_value": "",
          "enum": null,
          "is_system_provided": false,
          "required": false
        }
      ],
      "required": false,
      "value_type": "llm_prompt"
    },
    "request_headers": [
      {
        "type": "value",
        "name": "Content-Type",
        "value": "application/json"
      }
    ],
    "auth_connection": null
  },
  "response_timeout_secs": 20,
  "dynamic_variables": {
    "dynamic_variable_placeholders": {}
  }
}
